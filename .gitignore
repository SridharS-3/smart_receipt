# ==============================================================================
# Git Ignore Configuration for SmartReceipt
# ==============================================================================

# Environment configuration
.env
.env.local
.env.*.local
.env.backup
.env.production
.env.staging
!.env.example

# Composer dependency directory
/vendor/
composer.phar

# Node modules & logs (if used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server & Application Logs
*.log
logs/
storage/logs/
/storage/cache/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.buildpath
.settings/

# Temporary and Cache Files
tmp/
temp/
*.tmp
*.bak
*.old

# Database Backups & Dumps (keep database/migrations & database/schema.sql)
*.sql.gz
*.sql.tar.gz
*.sqlite
*.sqlite3

# PHPUnit / Test Caches
.phpunit.result.cache
.php_cs.cache

