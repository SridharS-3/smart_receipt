# ==============================================================================
# SmartReceipt - Application Environment Configuration
# ==============================================================================

# Application Environment (local, staging, production)
APP_NAME="SmartReceipt"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/smart_receipt
APP_TIMEZONE=Asia/Kolkata

# Database Connection (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_receipt_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SOCKET=/opt/lampp/var/mysql/mysql.sock

# Default Admin Credentials (used during initial database migration/seeding)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# Session Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false

